# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@localhost:5432/finance_controller
# Remote Supabase pooler format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_publishable_anon_key_here

# Application Configuration
APP_ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="LedgerLens"
LOG_LEVEL=INFO

# Security & Session Authentication (Required: minimum 32 random characters)
SECRET_KEY=your-secret-key-min-32-chars-long

# LLM Guidance / RAG Assistant (Optional: Groq API Key)
GROQ_API_KEY=your_groq_api_key_here
